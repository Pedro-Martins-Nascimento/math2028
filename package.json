{
  "name": "math2048",
  "version": "0.1.0",
  "description": "Jogo 2048 com desafios matemáticos (gatekeeper) e ranking global via Supabase, empacotado com Cordova.",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"www/js/**/*.js\"",
    "lint:fix": "eslint \"www/js/**/*.js\" --fix",
    "build:web": "esbuild www/js/main.js --bundle --target=es2018 --outfile=www/dist/bundle.js --format=iife",
    "build:web:prod": "esbuild www/js/main.js --bundle --target=es2018 --minify --outfile=www/dist/bundle.js --format=iife",
    "watch:web": "npm run build:web -- --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0"
  }
}
